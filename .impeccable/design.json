  "narrative": {
    "northStar": "The Status Light",
    "overview": "RepoBell is a small panel that you glance at. Like a status light on a desk, it should be calm until something needs you. The window is plain, flat and GNOME-native. It uses one blue, white cards on a warm grey ground, and thin borders. Nothing decorates. Everything that is not news steps back into grey.\n\nThe feel is quiet, plain and utilitarian. Text is short. Controls are large enough to hit with a mouse in a hurry. Density is medium: 420 by 640 pixels holds a column of cards, not a dashboard. The system is documented as built. It describes the current card list and does not prescribe a new layout.\n\nThe light theme is the only theme today. The code shows no dark mode.",
    "keyCharacteristics": [
      "Flat surfaces separated by 1px borders, not shadows.",
      "One accent blue, used for news, primary actions and focus.",
      "Warm neutral greys, never pure grey or black.",
      "Red, amber and green appear only as status, always as a pale wash with dark text.",
      "Ubuntu type at 12 to 18px, weights 400, 500 and 700.",
      "Large hit areas: 36 to 44px high controls."
    ],
    "rules": [
      { "name": "The One Blue Rule", "body": "Blue means \"this is new or this is the action.\" Never use it for decoration or for plain status.", "section": "colors" },
      { "name": "The Pale Wash Rule", "body": "Red, amber and green are never solid fills. They are a pale tint, a border and dark text. The only solid fill is the blue \"new\" badge.", "section": "colors" },
      { "name": "The Plain Size Rule", "body": "Use only 12, 13, 14, 15 and 18px. A new size needs a reason that is not taste.", "section": "typography" },
      { "name": "The Flat Card Rule", "body": "Cards never carry a shadow at rest. Borders do the separating.", "section": "elevation" }
    ],
    "dos": [
      "Do keep the window flat: white cards on Warm Canvas with 1px borders.",
      "Do reserve Signal Blue (#1f5fd1) for news, the main action and focus.",
      "Do make every control at least 36px high, and 40px or more for actions.",
      "Do show status as pale wash, border and dark text.",
      "Do keep the 2px blue focus outline on all focusable elements.",
      "Do honor `prefers-reduced-motion` for every animation.",
      "Do use Ubuntu with the system fallbacks."
    ],
    "donts": [
      "Don't add a second accent color or a solid red, amber or green fill.",
      "Don't add shadows to cards or buttons.",
      "Don't introduce a new radius or font size outside the scales above.",
      "Don't use pure black or pure grey. Use the warm Ink and Canvas values.",
      "Don't show commit SHAs or Git jargon beyond the short status labels."
    ]
  }
