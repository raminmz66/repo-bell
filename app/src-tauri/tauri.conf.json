{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoBell",
  "version": "0.1.0",
  "identifier": "io.github.raminmz66.repobell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RepoBell",
        "width": 420,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDRDgzODJEMzIyODVFODcKUldTSFhpZ3lMVGpZUElDWlJzc0NCK0xGVXJqUWlIUVpZLzFmMDF6ZHVad0hmeTVYclpVMnpJVEsK",
      "endpoints": ["https://github.com/raminmz66/repo-bell/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Ambient Git repo watcher with what's new feed",
    "longDescription": "RepoBell sits quietly in your Ubuntu top bar, watches your Git repos, and tells you when your team pushed changes without interrupting your flow.",
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["libxdo3", "git", "libnotify-bin", "zenity"]
      }
    }
  }
}
